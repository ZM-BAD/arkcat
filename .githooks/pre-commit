#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# Pre-commit hook
# 在 git commit 前自动运行质量检查
# ──────────────────────────────────────────────────────────────

set -euo pipefail

echo "🚀 Pre-commit 检查中..."
echo ""

# 1. 检查 commit message 格式（通过 prepare-commit-msg 钩子）
# 这里只检查代码和 spec

# 2. Spec 合规检查
echo "📋 检查 Spec 文件..."
bash scripts/check-spec.sh || exit 1

echo ""

# 3. 样式门禁：禁止 UI 硬编码颜色（与 pre-commit 框架的 check-hardcoded-colors 一致）
echo "🎨 检查硬编码颜色..."
python3 scripts/check-hardcoded-colors.py || exit 1

echo ""

# 4. 检查是否有未解决的 TODO/FIXME 在已暂存文件中（仅警告）
echo "🔎 扫描 TODO/FIXME..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
TODO_COUNT=0
for f in $STAGED_FILES; do
    if [ -f "$f" ] && grep -q -E "(TODO|FIXME|XXX|HACK)" "$f" 2>/dev/null; then
        TODO_COUNT=$((TODO_COUNT + 1))
    fi
done
if [ $TODO_COUNT -gt 0 ]; then
    echo "  ⚠️  $TODO_COUNT 个文件包含 TODO/FIXME（非阻塞，仅提醒）"
fi

echo ""
echo "✅ Pre-commit 检查通过"
exit 0
