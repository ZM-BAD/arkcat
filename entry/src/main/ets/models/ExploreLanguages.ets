/** 按语言名取色（查 linguist 官方色表；未知语言回 ''） */
export function programLanguageColor(name: string): string {
  for (const lang of LANGUAGE_COLORS) {
    if (lang.name === name) {
      return lang.color;
    }
  }
  return '';
}
