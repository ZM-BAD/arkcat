/**
 * Explore 筛选面板的语言常量（Spec 056 收口）。
 *
 * 说明：官方 App 的 Language 列表来自 GET /languages（免认证，833 项全量）——ABAP/ABAP CDS 等
 * 一切语言均在服务端返回，运行时经 ExploreService.fetchAllLanguages 获取；
 * 本文件仅内置 linguist 官方色表（ozh/github-colors 同步，751 项）与「常用 7 种」置顶序、
 * 网络失败时的回退子集。Spoken language 无公开接口，仍为内置常见子集。
 *
 * 注意：本文件是 check-hardcoded-colors.py 的豁免白名单（数据色板），
 * 页面/组件里禁止直接引用色值，只允许引用本文件导出的常量。
 */

/** 编程语言（name 与 GitHub search 的 language: qualifier 一致；color='' 表示 linguist 无定义色） */
export interface ExploreLanguage {
  name: string;
  color: string;
}

/** 官方「Filter by language」常用置顶组（2026-09-07 参考图顺序：Go→TypeScript） */
export const TOP_LANGUAGES: string[] = [
  'Go', 'Java', 'JavaScript', 'Jupyter Notebook', 'Python', 'Rust', 'TypeScript'
];

/** 语言排序（官方参考图顺序）：常用组置顶（各天然按 A-Z），其余字典序（数字开头自然在最前） */
export function sortLanguages(list: ExploreLanguage[]): ExploreLanguage[] {
  const top: ExploreLanguage[] = [];
  for (const name of TOP_LANGUAGES) {
    for (const lang of list) {
      if (lang.name === name) {
        top.push(lang);
        break;
      }
    }
  }
  const rest: ExploreLanguage[] = [];
  for (const lang of list) {
    if (TOP_LANGUAGES.indexOf(lang.name) < 0) {
      rest.push(lang);
    }
  }
  rest.sort((a: ExploreLanguage, b: ExploreLanguage): number => a.name.localeCompare(b.name));
  return top.concat(rest);
}

